<!--
  MuJoCo (MJCF) model of the 5-DOF arm + parallel gripper.

  Converted from the URDF in ../urdf/ so the same geometry can be simulated
  in MuJoCo. Generated by hand - keep it in sync when arm.xacro changes.

  Conventions
    - zero pose            arm straight up (+Z), same as the URDF
    - joint1               base yaw,  hinge about Z, +-135 deg
    - joint2               shoulder, hinge about Y, -45 .. +90 deg
    - joint3               elbow,    hinge about Y, +-90 deg
    - joint4               wrist,    hinge about Y, +-90 deg
    - joint5               wrist roll, hinge about Z, +-135 deg
    - gripper fingers      slide along X, 0 = open (80mm gap), 0.04 = closed
    - the right finger is kept symmetric through an equality constraint
      (MuJoCo has no "mimic" tag)

  Masses are ESTIMATES computed from geometry (geom density) plus one
  65 g servo body per moving link. Replace with real weights when known -
  every value is in the <default> block or on the individual geoms.
-->
<mujoco model="my_robot">

  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast"/>

  <default>
    <!-- child defaults must come first inside <default> -->
    <!-- servo bodies: decorative only, no collision -->
    <default class="servo">
      <geom type="box" size="0.02 0.02 0.0225" mass="0.065"
            rgba="0.85 0.25 0.55 1" contype="0" conaffinity="0"/>
    </default>
    <default class="link">
      <geom rgba="0.35 0.35 0.38 1"/>
    </default>

    <!-- Printed parts, effective density (includes ~25% infill).

         Collision filter - MuJoCo collides two geoms when
             (contype1 & conaffinity2) || (contype2 & conaffinity1)
         Arm geoms use contype=2, conaffinity=1 and world/objects use
         contype=1, conaffinity=1, so -
           arm  vs arm     (2&1)=0  -> no collision
           arm  vs object  (2&1)=2  -> collide
         Self-collision is OFF because the collision boxes inherited from
         the URDF overlap heavily (MoveIt used them only as proxies). Turn it
         back on per pair with <contact><exclude .../> once the boxes are
         shrunk to non-overlapping shapes. -->
    <geom density="600" friction="1.0 0.005 0.0001" contype="2" conaffinity="1"/>
    <joint damping="0.05" armature="0.01" frictionloss="0.02"/>
    <position kp="40" kv="2" ctrlrange="-3.15 3.15"/>
  </default>

  <worldbody>
    <light pos="0.5 -0.5 2.0" dir="-0.2 0.2 -1" diffuse="0.8 0.8 0.8"/>
    <geom name="floor" type="plane" size="2 2 0.1" rgba="0.85 0.85 0.9 1"
          contype="1" conaffinity="1"/>

    <!-- ============================ base ============================ -->
    <body name="base_link" pos="0 0 0">
      <geom name="base_plate" class="link" type="box" size="0.06 0.06 0.015"
            pos="0 0 0.015" rgba="0.5 0.5 0.5 1"/>

      <!-- ======================= base yaw ======================= -->
      <body name="shoulder_link" pos="0 0 0">
        <joint name="joint1" type="hinge" axis="0 0 1" range="-2.35619 2.35619"/>
        <geom name="shoulder_col" class="link" type="cylinder"
              size="0.05 0.01465" pos="0 0 0.01465" rgba="0.15 0.35 0.15 1"/>
        <geom name="servo_joint1" class="servo" pos="0 0 0.02"/>

        <!-- ======================= shoulder pitch ======================= -->
        <body name="arm_link" pos="0 0 0.0293">
          <joint name="joint2" type="hinge" axis="0 1 0" range="-0.785398 1.5708"/>
          <geom name="arm_box" class="link" type="box" size="0.03 0.03 0.059"
                pos="0 0 0.059"/>
          <geom name="servo_joint2" class="servo" pos="0 0 0.03"/>

          <!-- ======================= elbow pitch ======================= -->
          <body name="elbow_link" pos="0 0 0.118">
            <joint name="joint3" type="hinge" axis="0 1 0" range="-1.5708 1.5708"/>
            <geom name="elbow_box" class="link" type="box" size="0.03 0.03 0.046"
                  pos="0 0 0.046" rgba="0.2 0.25 0.5 1"/>
            <geom name="servo_joint3" class="servo" pos="0 0 0.03"/>

            <!-- ======================= wrist pitch ======================= -->
            <body name="forearm_link" pos="0 0 0.092">
              <joint name="joint4" type="hinge" axis="0 1 0" range="-1.5708 1.5708"/>
              <geom name="forearm_box" class="link" type="box" size="0.03 0.03 0.0155"
                    pos="0 0 0.0155"/>
              <geom name="servo_joint4" class="servo" pos="0 0 0.02"/>

              <!-- ======================= wrist roll ======================= -->
              <body name="wrist_link" pos="0 0 0.031">
                <joint name="joint5" type="hinge" axis="0 0 1" range="-2.35619 2.35619"/>
                <geom name="wrist_box" class="link" type="box" size="0.025 0.025 0.01"
                      pos="0 0 0.01" rgba="0.2 0.25 0.5 1"/>

                <!-- 30 mm from the joint5 axis to the gripper mount face -->
                <body name="hand_link" pos="0 0 0.02">
                  <geom name="hand_box" class="link" type="box" size="0.025 0.025 0.01"
                        pos="0 0 0.01"/>

                  <body name="tool_link" pos="0 0 0.01">
                    <!-- ================== gripper (simplified) ================== -->
                    <body name="gripper_base_link" pos="0 0 0">
                      <geom name="palm" type="box" size="0.04 0.01 0.01"
                            pos="0 0 0.01" rgba="0.15 0.35 0.15 1"/>

                      <!-- left finger: open at x=-45mm, travels +40mm to close -->
                      <body name="gripper_left_finger_link" pos="-0.045 0 0.02">
                        <joint name="gripper_left_finger_joint" type="slide"
                               axis="1 0 0" range="0 0.04"/>
                        <geom name="left_finger" type="box" size="0.005 0.01 0.04"
                              pos="0 0 0.04" rgba="0.25 0.65 0.25 1"/>
                      </body>

                      <!-- right finger: mirror, driven by the equality below -->
                      <body name="gripper_right_finger_link" pos="0.045 0 0.02">
                        <joint name="gripper_right_finger_joint" type="slide"
                               axis="1 0 0" range="-0.04 0"/>
                        <geom name="right_finger" type="box" size="0.005 0.01 0.04"
                              pos="0 0 0.04" rgba="0.25 0.65 0.25 1"/>
                      </body>
                    </body>
                  </body>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <!-- ===================== actuators ===================== -->
  <!-- qpos order: joint1 joint2 joint3 joint4 joint5  left_finger right_finger -->
  <actuator>
    <position name="act_joint1" joint="joint1" ctrlrange="-2.36 2.36"/>
    <position name="act_joint2" joint="joint2" ctrlrange="-0.79 1.58"/>
    <position name="act_joint3" joint="joint3" ctrlrange="-1.58 1.58"/>
    <position name="act_joint4" joint="joint4" ctrlrange="-1.58 1.58"/>
    <position name="act_joint5" joint="joint5" ctrlrange="-2.36 2.36"/>
    <position name="act_gripper" joint="gripper_left_finger_joint"
              ctrlrange="0 0.04" kp="80"/>
  </actuator>

  <!-- MuJoCo equivalent of the URDF <mimic> tag -->
  <equality>
    <joint joint1="gripper_left_finger_joint" joint2="gripper_right_finger_joint"
           polycoef="0 -1 0 0 0"/>
  </equality>

  <!-- home pose = servo zero pose, arm straight up, gripper open -->
  <keyframe>
    <key name="home"
         qpos="0 0 0 0 0 0 0"
         ctrl="0 0 0 0 0 0"/>
    <key name="ready"
         qpos="0 0.5 0.8 0.3 0 0.02 -0.02"
         ctrl="0 0.5 0.8 0.3 0 0.02"/>
  </keyframe>

</mujoco>
